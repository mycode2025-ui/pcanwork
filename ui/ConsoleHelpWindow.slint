// One-window Slint page split from the original monolithic file.
import { Button, ComboBox, LineEdit, CheckBox, TabWidget, ListView, ScrollView, VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";
import { ByteCell, SimRow, MsgRow, SigRow, TxSigRow, TxRow, PbFileRow, TreeRow, ChanStat, IdStat, ChartSeries, DbcSignalRow, SignalPickRow, I18n, Theme, ColW, Cell, HCell, SortHeader, TBtn, Icon, RibbonBtn, RibbonGroup, RibbonTab, ConvTab, SimGlyph, ThemedWindow } from "common.slint";

export component ConsoleHelpWindow inherits ThemedWindow {
    title: I18n.en ? "PcanWork - printf-over-CAN MCU Integration Guide" : "PcanWork - printf-over-CAN 单片机接入指南";
    icon: @image-url("logo.svg");
    preferred-width: 920px;
    preferred-height: 720px;
    min-width: 680px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    in property <string> help-text;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Text {
            text: I18n.en
                ? "Protocol, portable C implementation, STM32 adapters, RTOS guidance, and commissioning checklist"
                : "协议说明、可移植 C 实现、STM32 适配、RTOS 注意事项与联调验收";
            wrap: word-wrap; color: Theme.text; font-size: Theme.fs;
            font-weight: 700;
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel; border-width: 1px; border-color: Theme.border;
            border-radius: 4px;
            TextEdit {
                width: 100%; height: 100%;
                text: root.help-text;
                read-only: true;
                font-family: Theme.mono;
                font-size: 12px;
            }
        }
        Text {
            text: I18n.en ? "The guide is embedded in the executable. Ctrl+A / Ctrl+C copies the complete document."
                         : "帮助文档已内置在程序中；在正文中按 Ctrl+A、Ctrl+C 可复制完整内容。";
            color: Theme.text-dim; font-size: Theme.fs-sm;
        }
    }
}
