// Common types, globals and reusable widgets split from the original monolithic file.
import { Button, ComboBox, LineEdit, CheckBox, TabWidget, ListView, ScrollView, VerticalBox, HorizontalBox, TextEdit, Palette } from "std-widgets.slint";
import { ProductDesign, ProductI18n } from "design-system.slint";


export struct ByteCell {
    hex: string,
    hot: bool,
}

export struct TxByteCell {
    hex: string,
    valid: bool,
    enabled: bool,
}

export struct TxByteRow {
    offset: string,
    bytes: [TxByteCell],
}

// 仿真面板画布上一个控件的显示态
