    y: float,
    w: float,
    h: float,
    on: bool,        // 指示灯点亮
    level: float,    // 0..1: 仪表盘角度 / 进度条 / 滑块位置
    selected: bool,
    primary: bool,   // 主控件(等高/等宽的模板基准)
    align: int,      // 文本对齐: 0左 1中 2右
    trace-path-1: string,
    trace-path-2: string,
    trace-path-3: string,
    trace-path-4: string,
    trace-labels: string,
    series-label-1: string,
    series-label-2: string,
    series-label-3: string,
    series-label-4: string,
    series-value-1: string,
    series-value-2: string,
    series-value-3: string,
    series-value-4: string,
    series-level-1: float,
    series-level-2: float,
    series-level-3: float,
    series-level-4: float,
    series-on-1: bool,
    series-on-2: bool,
    series-on-3: bool,
    series-on-4: bool,
    range-label: string,
    paused: bool,
    alarm: bool,
    alarm-message: string,
    image-source: image,
    has-image: bool,
}

