import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit, Palette } from "std-widgets.slint";
import { ProductDesign, ProductHeaderButton, ProductHeaderCheck, ProductI18n, ProductLanguageSwitch, ProductThemeSwitch } from "../../ui/design-system.slint";

export global I18n {
    in-out property <bool> en: ProductI18n.en;
    changed en => { ProductI18n.en = en; }
    public pure function t(zh: string, eng: string) -> string {
        return ProductI18n.t(zh, eng);
    }
}

// 与 PcanWork 统一: 学术蓝(Academic Blue) 浅色配色
global Theme {
    in-out property <bool> dark: ProductDesign.dark;
    changed dark => { ProductDesign.dark = dark; }
    out property <color> bg: ProductDesign.window;
    out property <color> surface: ProductDesign.surface;
    out property <color> surface-2: ProductDesign.surface-raised;
    out property <color> border: ProductDesign.border;
    out property <color> text: ProductDesign.text;
    out property <color> muted: ProductDesign.text-muted;
    out property <color> accent: ProductDesign.brand;
    out property <color> accent-fg: ProductDesign.on-brand;
    out property <color> success: ProductDesign.success;
    out property <color> success-soft: ProductDesign.success-soft;
    out property <color> danger: ProductDesign.danger;
    out property <color> danger-soft: ProductDesign.danger-soft;
    out property <color> terminal-surface: ProductDesign.terminal-surface;
    out property <color> terminal-border: ProductDesign.terminal-border;
    out property <color> terminal-text: ProductDesign.terminal-text;
    out property <color> terminal-selection: ProductDesign.terminal-selection;
}

export struct QuickCommand {
    enabled: bool,
    hex: bool,
    payload: string,
    remark: string,
    delay-ms: int,
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;
}

component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: 11px;
}

component CardTitle inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 700;
}

// 高度不定死，跟随所在行拉伸，保证与同行的标题/控件垂直对齐
component CountBadge inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> tint: Theme.accent;
    height: 30px;
    background: Theme.surface-2;
    border-radius: 4px;
    border-color: Theme.border;
    border-width: 1px;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 4px;
        Text { text: root.label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        Text { text: "" + root.value; color: root.tint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
}

// 紧凑数字输入框：替代 SpinBox（fluent SpinBox 的上下箭头要占 ~50px，窄了必溢出）。
// 回车或失焦时提交，自动钳到 [minimum, maximum]，非数字输入恢复原值。
component NumEdit inherits LineEdit {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 1000000;
    in property <bool> allow-empty: false;
    callback committed();

    horizontal-alignment: right;
    font-size: 12px;
    text: root.allow-empty && root.value == 0 ? "" : "" + root.value;

    function commit() {
        if (root.allow-empty && root.text == "") {
            root.value = 0;
            root.text = "";
            root.committed();
            return;
        }
        if (root.text.is-float()) {
            root.value = Math.max(root.minimum, Math.min(root.maximum, Math.round(root.text.to-float())));
        }
        root.text = root.allow-empty && root.value == 0 ? "" : "" + root.value;
        root.committed();
    }

    accepted => { root.commit(); }
    changed has-focus => {
        if (!root.has-focus) {
            root.commit();
        }
    }
}

component QuickCommandRow inherits Rectangle {
    in property <int> idx;
    in property <bool> cmd-enabled;
    in property <bool> cmd-hex;
    in property <string> payload;
    in property <string> remark;
    in property <int> delay-ms;
    callback send(string, bool);
    callback edited(bool, bool, string, string, int);

    function notify() {
        root.edited(en-box.checked, hex-box.checked, payload-edit.text, remark-edit.text, delay-box.value);
    }

    height: 28px;
    background: transparent;

    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;
        Text { text: "" + root.idx; width: 22px; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
        en-box := CheckBox { checked: root.cmd-enabled; width: 22px; toggled => { root.notify(); } }
        hex-box := CheckBox { checked: root.cmd-hex; width: 22px; toggled => { root.notify(); } }
        payload-edit := LineEdit { text: root.payload; font-family: ProductDesign.font-mono; font-size: ProductDesign.font-sm; width: 210px; edited => { root.notify(); } }
        remark-edit := LineEdit { text: root.remark; font-size: 12px; width: 96px; edited => { root.notify(); } }
        delay-box := NumEdit { value: root.delay-ms; minimum: 0; maximum: 600000; allow-empty: true; width: 60px; committed => { root.notify(); } }
        Button {
            text: I18n.t("发送", "Send");
            width: 48px;
            clicked => { root.send(payload-edit.text, hex-box.checked); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// Academic-blue button matching PcanWork (std Button follows the system accent, so we draw our own).
component AccentBtn inherits Rectangle {
    in property <string> text;
    in property <bool> filled: true;       // true = accent fill, false = outlined
    in property <bool> btn-enabled: true;
    callback clicked;
    min-width: txt.preferred-width + 24px;
    height: ProductDesign.control-height;
    border-radius: 6px;
    accessible-role: AccessibleRole.button;
    accessible-label: root.text;
    accessible-enabled: root.btn-enabled;
    forward-focus: key-focus;
    accessible-action-default => { root.clicked(); }
    background: !root.btn-enabled ? Theme.surface-2
        : root.filled ? (ta.has-hover ? Theme.accent.brighter(0.12) : Theme.accent)
        : (ta.has-hover ? Theme.surface-2 : Theme.surface);
    border-width: key-focus.has-focus ? ProductDesign.focus-width : 1px;
    border-color: key-focus.has-focus ? ProductDesign.warning
        : !root.btn-enabled ? Theme.border
        : (root.filled ? Theme.accent : Theme.border);
    txt := Text {
        text: root.text;
        color: root.filled ? Theme.accent-fg : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        font-size: 12px;
    }
    ta := TouchArea {
        enabled: root.btn-enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.btn-enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component ToolCheck inherits CheckBox {
    height: ProductDesign.toolbar-control-height;
}

component ToolButton inherits Button {
    height: ProductDesign.toolbar-control-height;
    min-width: 72px;
}

component ToolStrip inherits ScrollView {
    height: ProductDesign.toolbar-control-height + ProductDesign.space-1;
    horizontal-stretch: 1;
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
    viewport-height: ProductDesign.toolbar-control-height;
}

export component AppWindow inherits Window {
    title: "Serial Tool";
    icon: @image-url("../assets/app.png");
    default-font-size: 12px;
    default-font-family: ProductDesign.font-sans;
    preferred-width: 940px;
    preferred-height: 580px;
    min-width: 920px;
    min-height: 540px;
    background: Theme.bg;
    always-on-top: root.topmost-enabled;
    in-out property <bool> dark: ProductDesign.dark;
    in-out property <bool> lang-en: I18n.en;
    changed lang-en => {
        I18n.en = root.lang-en;
        ProductI18n.en = root.lang-en;
    }
    changed dark => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // std-widgets 跟随本工具的 Dark/Light(而非系统), 初始按 Theme.dark。
    init => {
        Theme.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    in-out property <int> transport: 0; // 0=Serial 1=TCP Client 2=TCP Server 3=UDP 4=SSH Serial
    in-out property <[string]> ports;
    in-out property <string> selected-port;
    in-out property <[string]> baud-rates;
    in-out property <string> selected-baud;
    in-out property <[string]> data-bits;
    in-out property <string> selected-data-bits;
    in-out property <[string]> stop-bits;
    in-out property <string> selected-stop-bits;
    in-out property <[string]> parities;
    in-out property <string> selected-parity;
    in-out property <[string]> flow-controls;
    in-out property <string> selected-flow-control;
    in-out property <[string]> checksum-types: ["None", "SUM8", "XOR8", "CRC8", "CRC16-Modbus"];
    in-out property <string> selected-checksum: "None";
    in-out property <string> local-host: "0.0.0.0";
    in-out property <int> local-port: 502;
    in-out property <string> remote-host: "192.168.1.110";
    in-out property <int> remote-port: 502;
    // 原生 SSH 串口
    in-out property <string> ssh-host: "192.168.1.110";
    in-out property <string> ssh-user: "root";
    in-out property <int> ssh-port: 22;
    in-out property <string> ssh-key: "";
    in-out property <string> ssh-device: "/dev/ttyUSB0";
    in-out property <int> ssh-baud: 115200;
    in-out property <int> ssh-auth: 0; // 0=Private Key 1=Password
    in-out property <string> ssh-password: "";
    in-out property <string> ssh-cmd-template: "socat - {dev},raw,echo=0,b{baud}";
    in-out property <string> receive-text;
    in-out property <string> send-text;
    in-out property <string> selected-file;
    in-out property <string> status-message: "就绪";
    in property <string> io-health: "Q 0/4096 H0 D0";
    in property <bool> io-loss: false;
    in-out property <bool> connected;
    in-out property <bool> receive-hex;
    in-out property <bool> send-hex;
    in-out property <bool> timestamp-enabled: true;
    in-out property <bool> autoscroll: true;
    in-out property <bool> echo-tx: true;
    in-out property <bool> append-newline: true;
    in-out property <bool> receive-to-file;
    in-out property <bool> topmost-enabled;
    in-out property <int> timeout-ms: 20;
    in-out property <int> from-byte: 1;
    in-out property <bool> rts-enabled;
    in-out property <bool> dtr-enabled: true;
    in-out property <bool> auto-sending;
    in-out property <int> auto-interval-ms: 1000;
    in-out property <bool> quick-panel-visible: false;
    in-out property <int> rx-count;
    in-out property <int> tx-count;
    // 0=普通调试，1=交互终端。两种模式只切换右侧视图，共用当前连接与统计。
    in-out property <int> work-mode: 0;
    in-out property <string> terminal-text;
    in-out property <string> terminal-command;
    in-out property <bool> terminal-autoscroll: true;
    in-out property <bool> terminal-following: true;
    in-out property <bool> terminal-local-echo: true;
    in-out property <bool> terminal-ansi: true;
    in-out property <int> terminal-encoding: 0; // UTF-8, GBK, GB18030, Latin-1, ASCII
    in-out property <int> terminal-line-ending: 3; // None, CR, LF, CRLF
    in-out property <int> terminal-timestamp-mode: 0; // Off, HMS, milliseconds, full date
    in-out property <int> terminal-max-lines: 2; // 10k, 50k, 100k, 500k, unlimited
    in-out property <int> terminal-font-size: 14;
    in-out property <bool> terminal-save-history: true;
    in-out property <int> terminal-history-capacity: 500;
    in-out property <int> terminal-tab-width: 4;
    private property <int> rx-scroll-request;
    private property <int> terminal-focus-request;
    private property <int> terminal-blur-request;
    private property <int> terminal-scroll-request;

    callback refresh-ports();
    callback toggle-port();
    callback send-data();
    callback clear-receive();
    callback clear-send();
    callback save-receive();
    callback open-file();
    callback send-file();
    callback toggle-auto-send();
    callback stop-sending();
    callback save-settings();
    callback toggle-receive-file();
    callback toggle-quick-panel();
    callback english-changed();
    callback send-terminal-command(string);
    callback terminal-history(int, string) -> string;
    callback clear-terminal();
    callback save-terminal();
    callback switch-work-mode(int);


    // 把光标移到末尾，TextEdit 会自动把光标滚进视野 => 滚动条贴底
    public function scroll-rx-to-end() {
        root.rx-scroll-request += 1;
    }

    public function focus-terminal-input() {
        root.terminal-focus-request += 1;
    }

    public function blur-terminal-input() {
        root.terminal-blur-request += 1;
    }

    public function scroll-terminal-to-end() {
        root.terminal-following = true;
        root.terminal-scroll-request += 1;
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── 顶栏 ─────────────────────────────────────────────
        Rectangle {
            height: ProductDesign.product-header-height;
            background: ProductDesign.brand-header;
            Rectangle { y: parent.height - 1px; height: 1px; background: ProductDesign.on-brand-border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                Text {
                    text: I18n.t("串口调试工具", "Serial Tool");
                    color: ProductDesign.on-brand;
                    font-size: ProductDesign.product-title-font-size;
                    font-weight: 700;
                    height: ProductDesign.toolbar-control-height;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                }
                Rectangle {
                    min-width: 72px;
                    preferred-width: 72px;
                    max-width: 72px;
                    height: ProductDesign.toolbar-control-height;
                    horizontal-stretch: 0;
                    Rectangle {
                        width: 72px;
                        height: ProductDesign.status-chip-height;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: connected ? Theme.success-soft : Theme.danger-soft;
                        border-width: 1px;
                        border-color: connected ? Theme.success : Theme.danger;
                        Text {
                            text: connected ? I18n.t("已连接", "Online") : I18n.t("未连接", "Offline");
                            color: connected ? Theme.success : Theme.danger;
                            font-size: ProductDesign.font-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    min-width: 62px; preferred-width: 62px; max-width: 62px;
                    ProductHeaderCheck { fixed-width: 62px; text: I18n.t("置顶", "Pin"); checked <=> root.topmost-enabled; }
                }
                Rectangle {
                    min-width: 62px; preferred-width: 62px; max-width: 62px;
                    ProductLanguageSwitch { fixed-width: 62px; en <=> root.lang-en; changed(value) => { root.english-changed(); } }
                }
                Rectangle {
                    min-width: 88px; preferred-width: 88px; max-width: 88px;
                    ProductThemeSwitch { fixed-width: 88px; dark <=> root.dark; }
                }
                Rectangle {
                    min-width: 76px; preferred-width: 76px; max-width: 76px;
                    ProductHeaderButton { fixed-width: 76px; text: I18n.t("保存", "Save"); clicked => { root.save-settings(); } }
                }
                Rectangle {
                    min-width: 76px; preferred-width: 76px; max-width: 76px;
                    ProductHeaderButton {
                        fixed-width: 76px;
                        text: quick-panel-visible ? I18n.t("收起", "Hide") : I18n.t("命令", "Cmds");
                        clicked => { root.toggle-quick-panel(); }
                    }
                }
            }
        }

        // ── 主体：侧边栏 + 工作区 ────────────────────────────
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 1;

            // 侧边栏（ScrollView 比卡片宽 16px，给滚动条留位，避免裁掉右列控件）
            ScrollView {
                width: 266px;
                Card {
                    width: 250px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        CardTitle { text: I18n.t("连接", "Connection"); height: 18px; vertical-stretch: 0; }
                        ComboBox {
                            model: [I18n.t("串口", "Serial"), I18n.t("TCP 客户端", "TCP Client"), I18n.t("TCP 服务器", "TCP Server"), "UDP", I18n.t("SSH 串口", "SSH Serial")];
                            current-index <=> root.transport;
                            height: 30px;
                            vertical-stretch: 0;
                        }
                        if root.transport == 0: ComboBox {
                            model: root.ports;
                            current-value <=> root.selected-port;
                            height: 30px;
                            vertical-stretch: 0;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            height: 30px;
                            vertical-stretch: 0;
                            if root.transport == 0: Button { text: I18n.t("刷新", "Refresh"); clicked => { root.refresh-ports(); } }
                            AccentBtn {
                                text: connected ? I18n.t("断开", "Disconnect") : I18n.t("连接", "Connect");
                                filled: !connected;
                                horizontal-stretch: 1;
                                clicked => { root.toggle-port(); }
                            }
                        }

                        SectionLabel { text: I18n.t("工作模式", "Work Mode"); height: 18px; vertical-stretch: 0; }
                        HorizontalLayout {
                            spacing: 6px;
                            height: 30px;
                            vertical-stretch: 0;
                            AccentBtn {
                                text: I18n.t("普通调试", "Debug");
                                filled: root.work-mode == 0;
                                width: 112px;
                                clicked => { root.switch-work-mode(0); }
                            }
                            AccentBtn {
                                text: I18n.t("交互终端", "Terminal");
                                filled: root.work-mode == 1;
                                width: 112px;
                                clicked => { root.switch-work-mode(1); }
                            }
                        }

                        // ---- Serial 参数 ----
                        if root.transport == 0: VerticalLayout {
                            spacing: 6px;
                            height: 239px;
                            vertical-stretch: 0;
                            Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
                            CardTitle { text: I18n.t("串口参数", "Serial Params"); height: 18px; vertical-stretch: 0; }
                            SectionLabel { text: I18n.t("波特率", "Baud Rate"); height: 18px; vertical-stretch: 0; }
                            ComboBox {
                                model: root.baud-rates;
                                current-value <=> root.selected-baud;
                                height: 30px;
                                vertical-stretch: 0;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 50px;
                                vertical-stretch: 0;
                                VerticalLayout { spacing: 2px; width: 112px; SectionLabel { text: I18n.t("数据位", "Data"); height: 18px; vertical-stretch: 0; } ComboBox { width: 112px; height: 30px; vertical-stretch: 0; model: root.data-bits; current-value <=> root.selected-data-bits; } }
                                VerticalLayout { spacing: 2px; width: 112px; SectionLabel { text: I18n.t("停止位", "Stop"); height: 18px; vertical-stretch: 0; } ComboBox { width: 112px; height: 30px; vertical-stretch: 0; model: root.stop-bits; current-value <=> root.selected-stop-bits; } }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                height: 50px;
                                vertical-stretch: 0;
                                VerticalLayout { spacing: 2px; width: 112px; SectionLabel { text: I18n.t("校验位", "Parity"); height: 18px; vertical-stretch: 0; } ComboBox { width: 112px; height: 30px; vertical-stretch: 0; model: root.parities; current-value <=> root.selected-parity; } }
                                VerticalLayout { spacing: 2px; width: 112px; SectionLabel { text: I18n.t("流控", "Flow"); height: 18px; vertical-stretch: 0; } ComboBox { width: 112px; height: 30px; vertical-stretch: 0; model: root.flow-controls; current-value <=> root.selected-flow-control; } }
                            }
                            HorizontalLayout {
                                height: 30px;
                                vertical-stretch: 0;
                                CheckBox { text: "RTS"; checked <=> root.rts-enabled; }
                                CheckBox { text: "DTR"; checked <=> root.dtr-enabled; }
                            }
                        }

                        // ---- TCP/UDP ----
                        if root.transport >= 1 && root.transport <= 3: VerticalLayout {
                            spacing: 6px;
                            Rectangle { height: 1px; background: Theme.border; }
                            CardTitle { text: I18n.t("网络", "Network"); }
                            HorizontalLayout {
                                spacing: 5px;
                                SectionLabel { text: I18n.t("远程", "Rmt"); width: 28px; vertical-alignment: center; }
                                LineEdit { text <=> root.remote-host; width: 128px; font-size: 12px; }
                                NumEdit { value <=> root.remote-port; minimum: 1; maximum: 65535; width: 56px; }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                SectionLabel { text: I18n.t("本地", "Loc"); width: 28px; vertical-alignment: center; }
                                LineEdit { text <=> root.local-host; width: 128px; font-size: 12px; }
                                NumEdit { value <=> root.local-port; minimum: 1; maximum: 65535; width: 56px; }
                            }
                        }

                        // ---- SSH Serial ----
                        if root.transport == 4: VerticalLayout {
                            spacing: 6px;
                            Rectangle { height: 1px; background: Theme.border; }
                            CardTitle { text: I18n.t("SSH 串口", "SSH Serial"); }
                            SectionLabel { text: I18n.t("远端需装 socat", "remote needs socat"); }
                            HorizontalLayout { spacing: 5px; SectionLabel { text: I18n.t("主机", "Host"); width: 28px; vertical-alignment: center; } LineEdit { text <=> root.ssh-host; width: 110px; font-size: 12px; } NumEdit { value <=> root.ssh-port; minimum: 1; maximum: 65535; width: 50px; } }
                            HorizontalLayout { spacing: 5px; SectionLabel { text: I18n.t("用户", "User"); width: 28px; vertical-alignment: center; } LineEdit { text <=> root.ssh-user; width: 84px; font-size: 12px; } SectionLabel { text: I18n.t("波特", "Baud"); width: 28px; vertical-alignment: center; } NumEdit { value <=> root.ssh-baud; minimum: 50; maximum: 4000000; width: 84px; } }
                            HorizontalLayout { spacing: 5px; SectionLabel { text: I18n.t("设备", "Dev"); width: 28px; vertical-alignment: center; } LineEdit { text <=> root.ssh-device; placeholder-text: "/dev/ttyUSB0"; width: 168px; font-size: 12px; } }
                            SectionLabel { text: I18n.t("认证方式", "Auth"); }
                            ComboBox { model: [I18n.t("私钥", "Private Key"), I18n.t("密码", "Password")]; current-index <=> root.ssh-auth; }
                            if root.ssh-auth == 0: HorizontalLayout { spacing: 5px; SectionLabel { text: I18n.t("私钥", "Key"); width: 28px; vertical-alignment: center; } LineEdit { text <=> root.ssh-key; placeholder-text: I18n.t("可空=默认/agent", "blank=default/agent"); width: 168px; font-size: 12px; } }
                            if root.ssh-auth == 1: HorizontalLayout { spacing: 5px; SectionLabel { text: I18n.t("密码", "Pwd"); width: 28px; vertical-alignment: center; } LineEdit { text <=> root.ssh-password; input-type: InputType.password; width: 168px; font-size: 12px; } }
                            SectionLabel { text: I18n.t("远端命令模板", "Remote cmd"); }
                            LineEdit { text <=> root.ssh-cmd-template; font-size: 11px; }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // 工作区
            VerticalLayout {
                horizontal-stretch: 1;

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        visible: root.work-mode == 0;
                        spacing: 8px;

                // 接收卡片
                Card {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;
                            CardTitle { text: I18n.t("接收", "Receive"); vertical-alignment: center; }
                            CountBadge { label: "RX"; value: rx-count; }
                            ToolStrip { HorizontalLayout { spacing: 8px; height: 30px;
                            ToolCheck { text: I18n.t("自动滚动", "Follow"); checked <=> root.autoscroll; }
                            ToolCheck { text: "HEX"; checked <=> root.receive-hex; }
                            ToolCheck { text: I18n.t("时间戳分包", "Timestamp"); checked <=> root.timestamp-enabled; }
                            SectionLabel { text: I18n.t("超时", "Gap"); vertical-alignment: center; height: 30px; }
                            NumEdit { value <=> root.timeout-ms; minimum: 1; maximum: 60000; width: 56px; height: 30px; }
                            SectionLabel { text: "ms"; vertical-alignment: center; height: 30px; }
                            ToolCheck {
                                text: I18n.t("记录到文件", "Log to file");
                                checked <=> root.receive-to-file;
                                toggled => { root.toggle-receive-file(); }
                            }
                            ToolButton { text: I18n.t("保存", "Save"); clicked => { root.save-receive(); } }
                            ToolButton { text: I18n.t("清屏", "Clear"); clicked => { root.clear-receive(); } }
                        } }
                        }

                        rx-edit := TextEdit {
                            private property <int> scroll-request: root.rx-scroll-request;
                            text <=> root.receive-text;
                            font-family: ProductDesign.font-mono;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                            changed scroll-request => {
                                self.set-selection-offsets(self.text.character-count, self.text.character-count);
                            }
                        }
                    }
                }

                // 发送卡片
                Card {
                    height: 162px;
                    background: Theme.surface;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;
                            CardTitle { text: I18n.t("发送", "Send"); vertical-alignment: center; color: Theme.text; }
                            CountBadge { label: "TX"; value: tx-count; tint: Theme.success; }
                            ToolStrip { HorizontalLayout { spacing: 8px; height: 30px;
                            ToolCheck { text: I18n.t("回显", "Echo"); checked <=> root.echo-tx; }
                            ToolCheck { text: "HEX"; checked <=> root.send-hex; }
                            ToolCheck { text: I18n.t("回车换行", "CRLF"); checked <=> root.append-newline; }
                            SectionLabel { text: I18n.t("校验", "Checksum"); vertical-alignment: center; height: 30px; }
                            ComboBox { model: root.checksum-types; current-value <=> root.selected-checksum; width: 118px; height: 30px; }
                            SectionLabel { text: I18n.t("第", "from"); vertical-alignment: center; height: 30px; }
                            NumEdit { value <=> root.from-byte; minimum: 1; maximum: 4096; width: 44px; height: 30px; }
                            SectionLabel { text: I18n.t("字节起", "byte"); vertical-alignment: center; height: 30px; }
                        } }
                        }

                        TextEdit {
                            text <=> root.send-text;
                            font-family: ProductDesign.font-mono;
                            font-size: 12px;
                            vertical-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 5px;
                            Button { text: I18n.t("打开文件", "Open File"); clicked => { root.open-file(); } }
                            Button { text: I18n.t("发送文件", "Send File"); clicked => { root.send-file(); } }
                            Text {
                                text: selected-file == "" ? I18n.t("未选择文件", "No file") : selected-file;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            SectionLabel { text: I18n.t("定时", "Every"); vertical-alignment: center; }
                            NumEdit { value <=> root.auto-interval-ms; minimum: 1; maximum: 600000; width: 64px; }
                            SectionLabel { text: "ms"; vertical-alignment: center; }
                            Button {
                                text: auto-sending ? I18n.t("停止定时", "Stop Timer") : I18n.t("定时发送", "Auto Send");
                                clicked => { root.toggle-auto-send(); }
                            }
                            Button { text: I18n.t("停止", "Stop"); clicked => { root.stop-sending(); } }
                            Button { text: I18n.t("清空", "Clear"); clicked => { root.clear-send(); } }
                            AccentBtn {
                                text: I18n.t("发 送", "Send");
                                min-width: 84px;
                                clicked => { root.send-data(); }
                            }
                        }
                    }
                }

                }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.work-mode == 1;
                    background: Theme.terminal-surface;
                    border-color: Theme.terminal-border;
                    border-width: 1px;
                    border-radius: 6px;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 84px;
                            vertical-stretch: 0;
                            background: Theme.surface;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 8px;
                                spacing: 4px;

                                ToolStrip { HorizontalLayout { spacing: 8px; height: 30px;
                                    CardTitle { text: I18n.t("交互终端", "Terminal"); vertical-alignment: center; }
                                    CountBadge { label: "RX"; value: root.rx-count; }
                                    CountBadge { label: "TX"; value: root.tx-count; tint: Theme.success; }
                                    ToolCheck {
                                        text: I18n.t("自动滚动", "Follow");
                                        checked <=> root.terminal-autoscroll;
                                        toggled => {
                                            if self.checked {
                                                root.scroll-terminal-to-end();
                                            }
                                        }
                                    }
                                    ToolCheck { text: I18n.t("本地回显", "Local Echo"); checked <=> root.terminal-local-echo; }
                                    SectionLabel { text: I18n.t("时间戳", "Timestamp"); vertical-alignment: center; height: 30px; }
                                    ComboBox {
                                        model: [I18n.t("关闭", "Off"), I18n.t("时分秒", "HMS"), I18n.t("毫秒", "Millis"), I18n.t("完整日期", "Full")];
                                        current-index <=> root.terminal-timestamp-mode;
                                        width: 112px;
                                        height: 30px;
                                    }
                                    ToolCheck { text: "ANSI"; checked <=> root.terminal-ansi; }
                                } }

                                ToolStrip { HorizontalLayout { spacing: 7px; height: 30px;
                                    SectionLabel { text: I18n.t("编码", "Encoding"); vertical-alignment: center; height: 30px; }
                                    ComboBox {
                                        model: ["UTF-8", "GBK", "GB18030", "Latin-1", "ASCII"];
                                        current-index <=> root.terminal-encoding;
                                        width: 116px;
                                        height: 30px;
                                    }
                                    SectionLabel { text: I18n.t("换行", "EOL"); vertical-alignment: center; height: 30px; }
                                    ComboBox {
                                        model: ["None", "CR", "LF", "CRLF"];
                                        current-index <=> root.terminal-line-ending;
                                        width: 104px;
                                        height: 30px;
                                    }
                                    ToolCheck {
                                        text: I18n.t("记录到文件", "Log to file");
                                        checked <=> root.receive-to-file;
                                        toggled => { root.toggle-receive-file(); }
                                    }
                                    SectionLabel { text: I18n.t("字号", "Font"); vertical-alignment: center; height: 30px; }
                                    Button { text: "-"; width: 32px; height: 30px; clicked => { root.terminal-font-size = max(10, root.terminal-font-size - 1); } }
                                    Text { text: "" + root.terminal-font-size; width: 24px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                                    Button { text: "+"; width: 32px; height: 30px; clicked => { root.terminal-font-size = min(28, root.terminal-font-size + 1); } }
                                    SectionLabel { text: I18n.t("缓存", "Buffer"); vertical-alignment: center; height: 30px; }
                                    ComboBox {
                                        model: ["10,000", "50,000", "100,000", "500,000", I18n.t("不限制", "Unlimited")];
                                        current-index <=> root.terminal-max-lines;
                                        width: 120px;
                                        height: 30px;
                                    }
                                    ToolButton { text: I18n.t("跳至最新", "Jump to Latest"); clicked => { root.scroll-terminal-to-end(); root.focus-terminal-input(); } }
                                    ToolButton { text: I18n.t("保存", "Save"); clicked => { root.save-terminal(); root.focus-terminal-input(); } }
                                    ToolButton { text: I18n.t("清空", "Clear"); clicked => { root.clear-terminal(); root.focus-terminal-input(); } }
                                } }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.terminal-surface;
                            terminal-scroll := ScrollView {
                                private property <int> scroll-request: root.terminal-scroll-request;
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                viewport-height: terminal-output.height + 16px;
                                scrolled => {
                                    root.terminal-following = self.viewport-y <= min(0px, self.visible-height - self.viewport-height) + 2px;
                                }
                                changed scroll-request => {
                                    self.viewport-y = min(0px, self.visible-height - self.viewport-height);
                                }

                                terminal-output := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: max(100px, terminal-scroll.visible-width - 26px);
                                    height: max(terminal-scroll.visible-height - 16px, self.preferred-height + 4px);
                                    text: root.terminal-text;
                                    read-only: true;
                                    single-line: false;
                                    wrap: word-wrap;
                                    font-family: ProductDesign.font-mono;
                                    font-size: root.terminal-font-size * 1px;
                                    color: Theme.terminal-text;
                                    selection-background-color: Theme.terminal-selection;
                                    selection-foreground-color: Theme.accent-fg;
                                    key-pressed(event) => {
                                        if event.text == Key.Return {
                                            root.focus-terminal-input();
                                            return accept;
                                        } else if event.text == Key.UpArrow {
                                            root.terminal-command = root.terminal-history(-1, root.terminal-command);
                                            root.focus-terminal-input();
                                            return accept;
                                        } else if event.text == Key.DownArrow {
                                            root.terminal-command = root.terminal-history(1, root.terminal-command);
                                            root.focus-terminal-input();
                                            return accept;
                                        } else if !event.modifiers.control && !event.modifiers.alt && event.text.character-count == 1 {
                                            root.terminal-command += event.text;
                                            root.focus-terminal-input();
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 64px;
                            vertical-stretch: 0;
                            background: Theme.terminal-surface;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.terminal-surface;
                                    clip: true;
                                    terminal-input-scroll := ScrollView {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                        viewport-width: self.visible-width;
                                        viewport-height: max(self.visible-height, terminal-input.preferred-height);

                                    terminal-input := TextInput {
                                        private property <int> focus-request: root.terminal-focus-request;
                                        private property <int> blur-request: root.terminal-blur-request;
                                        x: 0px;
                                        y: 0px;
                                        width: terminal-input-scroll.visible-width;
                                        height: max(terminal-input-scroll.visible-height, self.preferred-height);
                                        text <=> root.terminal-command;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.terminal-text;
                                        selection-background-color: Theme.terminal-selection;
                                        selection-foreground-color: Theme.accent-fg;
                                        font-family: ProductDesign.font-mono;
                                        font-size: root.terminal-font-size * 1px;
                                        vertical-alignment: top;
                                        text-cursor-width: 1px;
                                        accessible-label: I18n.t("支持多行粘贴的终端命令", "Terminal command with multiline paste");
                                        changed focus-request => {
                                            self.focus();
                                            self.set-selection-offsets(self.text.character-count, self.text.character-count);
                                        }
                                        changed blur-request => { self.clear-focus(); }
                                        cursor-position-changed(cursor-position) => {
                                            if cursor-position.y + terminal-input-scroll.viewport-y < 4px {
                                                terminal-input-scroll.viewport-y = min(0px, -cursor-position.y + 4px);
                                            } else if cursor-position.y + terminal-input-scroll.viewport-y > terminal-input-scroll.visible-height - 22px {
                                                terminal-input-scroll.viewport-y = min(0px, terminal-input-scroll.visible-height - cursor-position.y - 22px);
                                            }
                                        }
                                        key-pressed(event) => {
                                            if event.text == Key.Return {
                                                root.send-terminal-command(root.terminal-command);
                                                return accept;
                                            } else if event.text == Key.UpArrow {
                                                root.terminal-command = root.terminal-history(-1, root.terminal-command);
                                                self.set-selection-offsets(root.terminal-command.character-count, root.terminal-command.character-count);
                                                return accept;
                                            } else if event.text == Key.DownArrow {
                                                root.terminal-command = root.terminal-history(1, root.terminal-command);
                                                self.set-selection-offsets(root.terminal-command.character-count, root.terminal-command.character-count);
                                                return accept;
                                            } else if event.text == Key.Escape || (event.modifiers.control && (event.text == "u" || event.text == "U")) {
                                                root.terminal-command = "";
                                                return accept;
                                            } else if event.modifiers.control && (event.text == "l" || event.text == "L") {
                                                root.clear-terminal();
                                                return accept;
                                            } else if event.modifiers.control && (event.text == "+" || event.text == "=") {
                                                root.terminal-font-size = min(28, root.terminal-font-size + 1);
                                                return accept;
                                            } else if event.modifiers.control && event.text == "-" {
                                                root.terminal-font-size = max(10, root.terminal-font-size - 1);
                                                return accept;
                                            } else if event.modifiers.control && event.text == "0" {
                                                root.terminal-font-size = 14;
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                                }
                            }
                        }
                    }
                }
                }
            }
        }

        // ── 状态栏 ───────────────────────────────────────────
        Rectangle {
            height: 24px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text { text: status-message; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.io-health; color: root.io-loss ? Theme.danger : Theme.muted; font-size: 11px; font-family: ProductDesign.font-mono; vertical-alignment: center; }
                Text { text: "TX " + tx-count; color: Theme.success; font-size: 11px; vertical-alignment: center; }
                Text { text: "RX " + rx-count; color: Theme.accent; font-size: 11px; vertical-alignment: center; }
                if root.work-mode == 1: Text {
                    text: (root.terminal-encoding == 0 ? "UTF-8" : root.terminal-encoding == 1 ? "GBK" : root.terminal-encoding == 2 ? "GB18030" : root.terminal-encoding == 3 ? "Latin-1" : "ASCII")
                        + " · "
                        + (root.terminal-line-ending == 0 ? "None" : root.terminal-line-ending == 1 ? "CR" : root.terminal-line-ending == 2 ? "LF" : "CRLF");
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: selected-baud + " · " + selected-data-bits + "-" + selected-parity + "-" + selected-stop-bits;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

}

// ── 多条命令：独立窗口，可拖出主窗口、可最小化 ──────────────
export component QuickWindow inherits Window {
    title: I18n.t("多条字符串发送", "Multi-String Send");
    icon: @image-url("../assets/app.png");
    default-font-size: 12px;
    preferred-width: 584px;
    preferred-height: 520px;
    min-width: 560px;
    min-height: 320px;
    background: Theme.bg;

    in-out property <[QuickCommand]> quick-commands;
    in-out property <bool> quick-loop-enabled;

    callback send-quick(string, bool);
    callback run-quick-sequence();
    callback stop-sending();
    callback import-quick-ini();
    callback export-quick-ini();
    callback add-quick-row();
    callback remove-quick-row();

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 5px;
            CheckBox { text: I18n.t("循环发送", "Loop"); checked <=> root.quick-loop-enabled; }
            AccentBtn { text: I18n.t("顺序发送", "Run Sequence"); clicked => { root.run-quick-sequence(); } }
            Button { text: I18n.t("停止", "Stop"); clicked => { root.stop-sending(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: I18n.t("导入ini", "Import"); clicked => { root.import-quick-ini(); } }
            Button { text: I18n.t("导出ini", "Export"); clicked => { root.export-quick-ini(); } }
            Button { text: "+"; width: 30px; clicked => { root.add-quick-row(); } }
            Button { text: "-"; width: 30px; clicked => { root.remove-quick-row(); } }
        }

        Rectangle {
            height: 24px;
            background: Theme.surface-2;
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 4px;
                spacing: 5px;
                Text { text: "#"; width: 22px; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                Text { text: I18n.t("启用", "On"); width: 22px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: "HEX"; width: 22px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: I18n.t("内容", "Payload"); width: 210px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: I18n.t("注释", "Remark"); width: 96px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Text { text: I18n.t("延时ms", "Delay"); width: 60px; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                for row[i] in root.quick-commands: QuickCommandRow {
                    idx: i + 1;
                    cmd-enabled: row.enabled;
                    cmd-hex: row.hex;
                    payload: row.payload;
                    remark: row.remark;
                    delay-ms: row.delay-ms;
                    edited(en, hx, pl, rm, dl) => {
                        row.enabled = en;
                        row.hex = hx;
                        row.payload = pl;
                        row.remark = rm;
                        row.delay-ms = dl;
                    }
                    send(pl, hx) => {
                        root.send-quick(pl, hx);
                    }
                }
            }
        }
    }
}
